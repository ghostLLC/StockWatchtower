# Copy this file to .env and fill in real values.
MODEL_BASE_URL=https://your-api-endpoint/v1
MODEL_API_KEY=sk-your-api-key
MODEL_NAME=gpt-4
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=your-email@qq.com
SMTP_PASS=your-smtp-auth-code
MAIL_TO=your-email@qq.com
# Dashboard token (optional, omit to disable auth)
DASHBOARD_TOKEN=change-me-please
